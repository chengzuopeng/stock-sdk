{
  "name": "stock-sdk-monorepo",
  "private": true,
  "type": "module",
  "description": "Stock SDK Monorepo: stock-sdk (zero-dependency browser + Node.js) & stock-node-sdk (Node.js multi-source high-availability edition with financials, news & announcements).",
  "homepage": "https://stock-sdk.linkdiary.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengzuopeng/stock-sdk.git"
  },
  "license": "ISC",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @stock-sdk/core build && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run",
    "test:integration:smoke": "RUN_INTEGRATION=1 vitest run packages/core/test/integration/providers/tencent/quote.int.test.ts packages/core/test/integration/providers/tencent/batch.int.test.ts packages/core/test/integration/providers/tencent/tradeCalendar.int.test.ts packages/core/test/integration/sdk/timeout.int.test.ts",
    "test:integration:node": "RUN_INTEGRATION=1 vitest run packages/stock-node-sdk/test/integration",
    "test:integration:full": "RUN_INTEGRATION=1 vitest run packages/core/test/integration packages/stock-node-sdk/test/integration",
    "docs:meta": "pnpm build && node ./scripts/generate-doc-meta.js && pnpm gen:llms",
    "docs:check": "pnpm docs:meta && node ./scripts/check-doc-consistency.js",
    "dev": "vitepress dev website",
    "preview": "vitepress preview website",
    "build:docs": "pnpm docs:meta && DOCS_BASE=/ vitepress build website",
    "build:pages": "pnpm docs:meta && DOCS_BASE=/stock-sdk/ vitepress build website",
    "gen:llms": "tsx ./scripts/generate-llms.ts",
    "gen:indicator-baseline": "tsx ./scripts/gen-indicator-baseline.ts",
    "prepare": "node ./scripts/install-git-hooks.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@grafana/faro-rollup-plugin": "^0.7.1",
    "@grafana/faro-web-sdk": "^2.1.0",
    "@grafana/faro-web-tracing": "^2.1.0",
    "@iconify/vue": "^5.0.0",
    "@types/node": "^24.10.2",
    "@vitest/coverage-v8": "^4.0.16",
    "msw": "^2.10.4",
    "playwright": "^1.58.2",
    "shiki": "^2.5.0",
    "tsup": "^8.3.5",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.15",
    "vue": "^3.5.26"
  },
  "packageManager": "pnpm@10.34.4"
}
